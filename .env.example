# ==========================================
# CineFlix Environment Configuration Example
# ==========================================

# 1. TMDB API Key (영화 상세 및 예고편 정보)
TMDB_API_KEY=335d351f298a859d0ea6f8b1808ae017

# 2. KOBIS API Key (한국 박스오피스 일별 순위)
KOBIS_API_KEY=183da6c4fa3be1aadb21ae6ca7cdf1c0

# 3. JWT Secret (사용자 인증 토큰 서명 키)
JWT_SECRET=cineflix_secret_jwt_key_super_secure_random_string_2026_demo_project_key

# 4. 실서버 이메일(SMTP) 발송 설정
# Google Gmail 사용 시:
#  - 계정 보안 설정에서 2단계 인증 활성화 후 '앱 비밀번호(16자리)' 발급 필요
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-16-digit-app-password

# Naver 메일 사용 시:
#  - 네이버 메일 환경설정 -> POP3/IMAP 설정 -> IMAP/SMTP 사용 '사용함' 설정
# SPRING_MAIL_HOST=smtp.naver.com
# SPRING_MAIL_PORT=465
# SPRING_MAIL_USERNAME=your-id@naver.com
# SPRING_MAIL_PASSWORD=your-naver-password
